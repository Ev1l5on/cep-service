{
  "id": null,
  "uid": "cep-service-observabilidade",
  "title": "CEP Service — Observabilidade",
  "description": "HTTP e JVM coletados a cada 15 segundos pelo Prometheus. Contratos e fluxo Kafka preservados.",
  "tags": [
    "cep-service",
    "http",
    "jvm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Volume HTTP no periodo",
      "type": "stat",
      "description": "Estimativa de requisicoes no intervalo selecionado, excluindo Actuator. increase considera reinicios do contador.",
      "datasource": {
        "type": "prometheus",
        "uid": "cep-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"cep-service\",uri!~\"/actuator.*\"}[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "cep-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Disponibilidade — scrape da aplicacao",
      "type": "stat",
      "description": "UP indica que Prometheus conseguiu coletar app:8080/actuator/prometheus. Nao mede a saude de todas as dependencias.",
      "datasource": {
        "type": "prometheus",
        "uid": "cep-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"cep-service\"}",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "cep-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Taxa de erros HTTP 5xx",
      "type": "stat",
      "description": "Fracao das requisicoes HTTP com status 5xx na janela de rate, excluindo Actuator. Sem 5xx, exibe zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "cep-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"cep-service\",uri!~\"/actuator.*\",status=~\"5..\"}[$__rate_interval])) or on() vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"cep-service\",uri!~\"/actuator.*\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "cep-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Taxa de requisicoes HTTP por segundo",
      "type": "timeseries",
      "description": "Requisicoes por segundo por metodo e rota normalizada; exclui healthchecks e scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "cep-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"cep-service\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "cep-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Latencia HTTP p95",
      "type": "timeseries",
      "description": "Percentil 95 aproximado a partir dos buckets Micrometer. Sem requisicoes recentes, pode nao haver valor.",
      "datasource": {
        "type": "prometheus",
        "uid": "cep-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"cep-service\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "cep-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Memoria JVM utilizada",
      "type": "timeseries",
      "description": "Memoria utilizada por area heap e nonheap; nao representa toda a memoria do container.",
      "datasource": {
        "type": "prometheus",
        "uid": "cep-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (area) (jvm_memory_used_bytes{job=\"cep-service\"})",
          "legendFormat": "{{area}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "cep-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Utilizacao de CPU do processo JVM",
      "type": "timeseries",
      "description": "Uso recente de CPU do processo, conforme reportado pelo JVM/Micrometer. Pode variar conforme suporte do ambiente.",
      "datasource": {
        "type": "prometheus",
        "uid": "cep-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{job=\"cep-service\"}",
          "legendFormat": "JVM",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "cep-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
