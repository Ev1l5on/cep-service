# Execucao local/IntelliJ: endpoints publicados no Mac.
# O servico app do Compose sobrescreve host/porta para postgres:5432 e kafka:29092.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cep_service
POSTGRES_USER=cep_service
# Preencha apenas no .env local com uma senha gerada, por exemplo: openssl rand -hex 24
POSTGRES_PASSWORD=

# Aplicacao no Mac; nao e necessario alterar este valor para usar o Compose completo.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# Porta HTTP publicada em 127.0.0.1 pelo Docker Compose.
APP_PORT=8080
