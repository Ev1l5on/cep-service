# Aplicacao executada no host; PostgreSQL executado no Docker Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cep_service
POSTGRES_USER=cep_service
# Preencha apenas no .env local com uma senha gerada, por exemplo: openssl rand -hex 24
POSTGRES_PASSWORD=

# Aplicacao no Mac: localhost. Em um futuro container: kafka:29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
